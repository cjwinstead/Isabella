`timescale 1ns/1ps

module test_debouncer ();

   reg clk;

   initial begin
      clk = 0;
      forever #5 clk = ~clk;
   end

   reg rst;
   reg btn;
   
   debouncer DUT (
		   .clk(clk),
		   .rst(rst),
		   .btn(btn),
		   .db(db)
		  );

   initial begin
      rst = 1;
      btn = 0;

      $display("clk  btn   db   count   state");
      
      $monitor("%4d %b   %b   %4d   %2d",clk_count,btn,db,DUT.count,DUT.state);
      
   end


   integer clk_count;
   initial clk_count = 0;
   always @(posedge clk) begin
      clk_count <= clk_count + 1;
      if (clk_count == 10000) begin
	 // Things to do at finish
	 $finish;
      end
   end

   always @(posedge clk) begin
      rst <= 0;

      case (clk_count)
	50: btn <= 1;
	500: btn <= 0;
      endcase // case (clk_count)
      
   end
   

   
endmodule //
